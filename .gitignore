# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment / secrets - never commit these (engineering spec §37)
.env
.env.*
!.env.example

# Swiss Ephemeris data files, if ever added: large binaries, licence-bound
*.se1

# Local dev database (default DATABASE_URL). Contains real user data once the
# app is used, never a fixture - must never be committed.
*.db
*.db-journal

# Scratch file for composing multi-line commit messages, used with
# `git commit -F .commitmsg`. Pasting a multi-line `-m` into the shell drops
# everything after the first newline.
.commitmsg

# Editors / OS
.DS_Store
.idea/
*.swp
