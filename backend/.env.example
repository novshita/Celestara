# Copy to .env and adjust. Nothing here is required to run locally - every
# variable has a documented default (see app/core/logging.py, app/db/session.py,
# app/services/auth/service.py) - this file exists so the available settings
# are discoverable in one place rather than only in code comments.

# SQLAlchemy connection string. Defaults to a local SQLite file
# (sqlite:///./celestara.db). Engineering spec §4 names PostgreSQL as the
# production store, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/celestara

# Whether the API applies pending schema migrations when it starts. Defaults
# to true. Set to false and run `alembic upgrade head` yourself (from
# backend/) when several workers start at once - two migrating at the same
# moment would race.
# AUTO_MIGRATE=true

# How long a login session stays valid, in days. Defaults to 30.
# SESSION_TTL_DAYS=30

# Root logger level. Defaults to INFO.
# LOG_LEVEL=INFO

# Required for the AI Guide (/api/v1/ai/chat) to work at all - the `anthropic`
# SDK reads this directly, so there is no in-app default for the key itself.
# Get one at https://console.anthropic.com/settings/keys.
# ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model answers AI Guide questions. Defaults to claude-opus-5-5.
# Lower-cost options exist (e.g. claude-sonnet-5-5, claude-haiku-5-5) - this
# is a cost/quality tradeoff for whoever runs the deployment to make, not a
# silent default.
# ANTHROPIC_MODEL=claude-opus-5-5

# How many AI requests (/ai/chat and /readings/*) one client may make per
# minute, across all of those endpoints together. Defaults to 10; 0 turns
# limiting off. In-memory, so it is per process and resets on restart.
# AI_RATE_LIMIT_PER_MINUTE=10

# Who counts as "one client". By default, the connecting address - and since
# the frontend calls this API from its own server, that means every end user
# shares one allowance. Set to true ONLY when exactly one trusted proxy sits
# in front of the API and sets X-Forwarded-For; the header is otherwise
# client-controlled, so trusting it lets anyone dodge the limit.
# RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Prometheus metrics at GET /metrics: request counts and latency by route,
# AI provider calls and latency, safety actions, rate-limited requests. No
# request content or personal data. Off by default; the endpoint does not
# exist unless this is true.
# METRICS_ENABLED=false

# If set, /metrics requires `Authorization: Bearer <this value>`. Set it
# whenever /metrics is reachable beyond a private network.
# METRICS_TOKEN=
