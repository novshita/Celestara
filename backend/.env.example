# Copy to .env and adjust. Nothing here is required to run locally - every
# variable has a documented default (see app/core/logging.py, app/db/session.py,
# app/services/auth/service.py) - this file exists so the available settings
# are discoverable in one place rather than only in code comments.

# SQLAlchemy connection string. Defaults to a local SQLite file
# (sqlite:///./celestara.db). Engineering spec §4 names PostgreSQL as the
# production store, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/celestara

# How long a login session stays valid, in days. Defaults to 30.
# SESSION_TTL_DAYS=30

# Root logger level. Defaults to INFO.
# LOG_LEVEL=INFO
