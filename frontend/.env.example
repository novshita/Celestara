# Copy to .env.local and adjust. Nothing here is required for local
# development against the default backend setup - see backend/.env.example
# for the FastAPI side.

# Where the Celestara backend is running. Read server-side only (Server
# Functions in app/actions.ts); never exposed to the browser, so the
# backend's location is never bundled into client JavaScript. Defaults to
# http://127.0.0.1:8000, the address `uvicorn app.main:app` binds to.
# BACKEND_URL=http://127.0.0.1:8000

# Pass the end user's address to the backend on AI requests, so its per-client
# rate limit counts each person separately instead of treating every visitor
# as this server. Set to true ONLY when exactly one trusted proxy sits in
# front of this app and appends the real client address to X-Forwarded-For
# (the header is passed through untouched), and set
# RATE_LIMIT_TRUST_FORWARDED_FOR=true on the backend to match. With no such
# proxy a visitor could send any value and dodge the limit, so leave it off.
# FORWARD_CLIENT_IP=false
